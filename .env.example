# =====================================================================
# Royal Chain Wallet — Environment Variables (Phase 10)
#
# Copy to .env and fill in with YOUR real credentials. Every value below
# is unset in this repository — nothing here is a real secret, and
# nothing in the application code has a hardcoded fallback for any of
# these (verified by audit in Phase 10 — see docs/PRODUCTION_READINESS.md).
#
# VITE_-prefixed vars are exposed to the CLIENT bundle (Vite convention).
# Never put a genuine secret behind a VITE_ prefix — anything without
# that prefix is server-only and read via process.env in src/server/*.
#
# See docs/CREDENTIALS.md for what each of these is, where to get it,
# and what breaks (safely — falls back to mock data) if you skip it.
# =====================================================================

# --- Supabase (already provisioned by the platform — check your own .env) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=

# --- REQUIRED before any admin feature or the MCP server's admin tools work ---
# Server-only. Same Supabase project as above. Get from: Supabase Dashboard
# → Project Settings → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# --- Blockchain RPC endpoints (each is independently optional — unset
#     chains fall back to mock data automatically; the app never crashes
#     on a missing one) ---
VITE_SOL_RPC_URL=
VITE_ETH_RPC_URL=
VITE_BNB_RPC_URL=
VITE_BTC_API_URL=
VITE_POLYGON_RPC_URL=
VITE_BASE_RPC_URL=

# --- WalletConnect / Reown (Phase 10) — required for the "Connect via
#     WalletConnect" flow (src/routes/app.walletconnect.tsx) to work at
#     all; without it that screen shows a clear "not configured" state. ---
VITE_WALLETCONNECT_PROJECT_ID=

# --- Token contracts (optional — leave unset until you have real mint/
#     contract addresses; ROY especially, since it's your own token) ---
VITE_ROY_MINT=
VITE_USDT_MINT=
VITE_USDC_MINT=

# --- Royal Chain backend API (optional — only relevant if you stand up
#     a separate REST API instead of using src/server/* server functions) ---
VITE_API_BASE_URL=

# --- Pricing / market data provider (optional — falls back to static
#     mock exchange rates in lib/currencies.ts) ---
VITE_PRICE_PROVIDER_URL=
VITE_PRICE_PROVIDER_API_KEY=

# --- Push notifications (optional — not yet wired to any UI; see
#     docs/REMAINING_WORK.md) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Feature flag overrides (optional, comma-separated) ---
# e.g. VITE_FEATURE_FLAGS=live_rpc,live_pricing
VITE_FEATURE_FLAGS=

# --- App metadata ---
VITE_APP_ENV=development
