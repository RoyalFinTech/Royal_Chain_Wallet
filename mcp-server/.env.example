# Royal Chain Wallet MCP server — own credentials, separate from the
# browser app's .env (which only ever holds the public anon key).

# Same Supabase project as the main app.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Service-role key — grants full read access bypassing RLS. Used only by
# the admin tools (search_user, admin_dashboard, database_status).
# NEVER expose this key to an MCP client or commit it to source control.
SUPABASE_SERVICE_ROLE_KEY=
